+# ══ LAS FICHAS: que dato trae cada producto, de que clase y en que rubros ═══
+#
+# EL MODELO VEIA LOS NOMBRES DE LOS CAMPOS Y NO LO QUE HAY ADENTRO (29-sep).
+# Medido con sesenta mensajes nuevos, tres corridas: "parlante que se pueda
+# mojar" filtro por `caracteristicas_extra` teniendo `resistencia_agua`, y
+# contesto "no tenemos" con dos parlantes IP67 en stock; "el monitor mas
+# grande" ordeno por `dimensiones`, que es una etiqueta, y afirmo 32 pulgadas
+# con uno de 49. El codigo ya sabia las dos cosas —el tipo de cada campo y si
+# ordena— y no se las decia. Esto se las dice, derivado del catalogo: no crece
+# con los productos, crece con los campos.
+
+_LARGO_MAGNITUD = 20
+_VALORES_DE_MUESTRA = 4
+
+
+def _es_magnitud(v) -> bool:
+    """"75Hz", "512GB SSD", "4.2W RMS": el numero adelante y corto. "core i5
+    16gb" o una descripcion traen numeros y no son una medida del producto."""
+    from app.core.fuente_producto import valor_numerico
+    if isinstance(v, (int, float)) and not isinstance(v, bool):
+        return True
+    s = str(v or "").strip()
+    return (len(s) <= _LARGO_MAGNITUD and re.match(r"\d", s) is not None
+            and valor_numerico(s) is not None)
+
+
+def _fichas(tienda_id: str, prods: list) -> dict:
+    """{campo: {tipo, valores, rubros}}. `tipo` es `magnitud` si sus valores
+    son medidas y se puede ordenar, `si_no`, `lista` si tiene pocos valores cortos, o
+    `texto`. `rubros` son los rubros donde la mitad de los productos lo trae."""
+    from app.core.filtros_catalogo import _valor_crudo, campos_filtrables, recorrida
+    campos = campos_filtrables(tienda_id)
+    vistos = recorrida(tienda_id).get("valores") or {}
+    por_rubro: dict = {}
+    for p in prods:
+        if isinstance(p, dict) and p.get("categoria"):
+            por_rubro.setdefault(p["categoria"], []).append(p)
+    out = {}
+    for c, tipo in campos.items():
+        rubros, todos = [], []
+        for rb, ps in por_rubro.items():
+            vals = [v for v in (_valor_crudo(p, c) for p in ps) if v not in (None, "", [], {})]
+            if len(vals) < len(ps) * 0.5:
+                continue
+            rubros.append(rb)
+            todos += vals
+        # Sobre TODOS sus valores: `caracteristicas_extra` dice "8GB GDDR6" en
+        # las placas de video y "sensor optico" en el resto. No es una medida.
+        magnitud = bool(todos) and sum(1 for v in todos if _es_magnitud(v)) >= len(todos) * 0.8
+        v = vistos.get(c) or {}
+        cuenta = v.get("vistos") or {}
+        lista = list(cuenta)
+        if tipo == "si_no":
+            clase = "si_no"
+        elif magnitud:
+            clase = "magnitud"
+        elif not v.get("truncado") and len(lista) <= 8 and all(len(str(x)) <= 20 for x in lista):
+            clase = "lista"
+        else:
+            clase = "texto"
+        # COMO LO ESCRIBE LA FUENTE. El modelo pedia `ram igual 16` y la fuente
+        # dice "16gb": el motor lo rechazaba por vocabulario y el bot elegia uno
+        # de cinco. Y pedia `bluetooth` para "inalambrico" teniendo `conexion`
+        # que dice "inalambrico". Los valores mas repetidos y cortos; un campo
+        # donde cada producto dice otra cosa —nombre, descripcion— no lleva.
+        if clase == "lista":
+            valores = lista
+        elif clase == "si_no":
+            valores = []
+        else:
+            valores = [str(x) for x, n in sorted(cuenta.items(), key=lambda kv: -kv[1])
+                       if n > 1 and len(str(x)) <= 30][:_VALORES_DE_MUESTRA]
+        out[c] = {"tipo": clase, "valores": valores,
+                  "rubros": [] if len(rubros) >= len(por_rubro) - 2 else rubros}
+    return out
+
+
+def ordenables(tienda_id: str) -> list:
+    return sorted(c for c, f in indice(tienda_id)["fichas"].items() if f["tipo"] == "magnitud")
+
+
+def fichas_texto(tienda_id: str) -> str:
+    """Una linea por campo: que clase de dato es y en que rubros esta."""
+    clase = {"magnitud": "medida, se ordena", "si_no": "si o no", "texto": "texto", "lista": "solo estos valores"}
+    lineas = []
+    for c, f in sorted(indice(tienda_id)["fichas"].items()):
+        que = clase[f["tipo"]]
+        if f["valores"]:
+            que += (": " if f["tipo"] == "lista" else ", la fuente escribe: ") + " | ".join(f["valores"])
+        donde = ", ".join(f["rubros"]) if f["rubros"] else "todos"
+        lineas.append(f"- {c} ({que}). En: {donde}")
+    return "\n".join(lineas)
+
+

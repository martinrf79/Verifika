+def _del_rubro(rub: str, tienda_id: str) -> list:
+    from app.storage.firestore_client import get_all_products
+    return [p for p in get_all_products(tienda_id=tienda_id) or [] if p.get("categoria") == rub]
+
+
+def _valores_en(prods: list, campo: str, n: int = 6) -> list:
+    """Como escribe la fuente ese dato en esos productos: el libro, abierto."""
+    from app.core.filtros_catalogo import _valor_crudo
+    cuenta: dict = {}
+    for p in prods:
+        v = _valor_crudo(p, campo)
+        if v not in (None, "", [], {}):
+            cuenta[str(v).lower()] = cuenta.get(str(v).lower(), 0) + 1
+    return [v for v, _ in sorted(cuenta.items(), key=lambda kv: -kv[1])][:n]
+
+
+def revisar(nombre: str, args: dict, tienda_id: str) -> list:
+    """Lo que no cierra del pedido, con lo que si existe. Vacio si cierra."""
+    from app.core.filtros_catalogo import _valor_crudo, campos_con_el_valor, campos_filtrables, evaluar
+    ix = indice(tienda_id)
+    fichas, errores = ix["fichas"], []
+    rubros = {_n(r) for r in ix["rubros"]}
+    if nombre in ("producto", "reservar", "compatibilidad"):
+        nom = str(args.get("nombre") or args.get("producto") or "")
+        if nom and _n(nom) in rubros:
+            errores.append(f"'{nom}' es un rubro, no un producto. Si el cliente no dijo cual, preguntaselo; "
+                           f"si pregunta por todos, usa buscar")
+    if nombre == "cuenta" and args.get("reparto_pago"):
+        rep = [x for x in args["reparto_pago"] if isinstance(x, dict)]
+        total = sum(float(x.get("porcentaje") or 0) for x in rep)
+        if abs(total - 1) < 0.01:
+            for x in rep:
+                x["porcentaje"] = round(float(x.get("porcentaje") or 0) * 100, 2)
+        elif rep and abs(total - 100) > 0.5:
+            errores.append(f"el reparto suma {total:g}; tiene que sumar 100")
+    if nombre == "buscar":
+        rub, _ = _rubro(str(args.get("rubro") or ""), tienda_id)
+        prods = _del_rubro(rub, tienda_id) if rub else []
+        tipos = campos_filtrables(tienda_id)
+        for c in args.get("condiciones") or []:
+            if not isinstance(c, dict):
+                continue
+            campo, valor, op = c.get("campo"), str(c.get("valor") or ""), c.get("operador")
+            f = fichas.get(campo)
+            if f is None or not rub:
+                continue
+            if f["rubros"] and rub not in f["rubros"]:
+                # SI EL VALOR VIVE EN OTRO DATO DEL RUBRO, SE ATERRIZA AHI, como
+                # hace `h_buscar` con el cero. Medido en C30: "formato ddr5" en
+                # memorias se rechazaba, el modelo buscaba "DDR5" como texto,
+                # volvian DDR4 y el bot dijo que no hay DDR5.
+                donde = campos_con_el_valor(prods, valor, tienda_id) if prods and valor else []
+                if donde:
+                    c["campo"] = "nombre" if "nombre" in donde else donde[0]
+                    c["operador"] = "no_contiene" if op in ("no_contiene", "evita") else "contiene"
+                    continue
+                errores.append(f"en {rub} no hay dato {campo}; esta en: {', '.join(f['rubros'])}")
+                continue
+            if f["tipo"] == "lista" and op in ("contiene", "igual", "prefiere") and \
+                    _n(valor) not in {_n(v) for v in f["valores"]}:
+                # UN VALOR FUERA DE LA LISTA PUEDE VIVIR EN OTRO DATO. Medido en
+                # C30: "formato igual ddr5" se nego como que la tienda no lo
+                # tiene, y las DDR5 estan en el nombre: el bot dijo que no hay.
+                if prods and campos_con_el_valor(prods, valor, tienda_id):
+                    continue
+                errores.append(f"'{valor}' no es un valor de {campo}; sus valores son: {' | '.join(f['valores'])}")
+                continue
+            # UN VALOR QUE EL RUBRO NO ESCRIBE EN NINGUN LADO. Si vive en otro
+            # campo, `h_buscar` ya lo reubica: aca solo lo que no esta en ninguno.
+            if f["tipo"] in ("texto", "magnitud") and op in ("contiene", "igual") and prods and \
+                    any(_valor_crudo(p, campo) not in (None, "", [], {}) for p in prods) and \
+                    not any(evaluar(p, campo, op, valor, tipos.get(campo, "texto")) is True for p in prods) and \
+                    not campos_con_el_valor(prods, valor, tienda_id):
+                errores.append(f"en {rub}, {campo} no dice '{valor}'; ahi la fuente escribe: "
+                               f"{' | '.join(_valores_en(prods, campo))}")
+    return errores
+

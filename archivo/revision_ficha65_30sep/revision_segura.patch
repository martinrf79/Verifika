+def excluidas_del_mensaje(mensaje: str, tienda_id: str) -> list:
+    """Las marcas que el cliente excluye en ESTE mensaje."""
+    marcas = _marcas(tienda_id)
+    out = []
+    for grupo in _EXCLUYE_CADENA.findall(_n(mensaje)):
+        for w in re.split(r"\s*(?:,|\bni\b|\by\b|\bo\b)\s*", grupo):
+            if w in marcas and marcas[w] not in out:
+                out.append(marcas[w])
+    return out

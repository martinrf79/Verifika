+    return [m for m in excluidas_del_mensaje(mensaje, tienda_id)
+            if not any(_n(m) in _n(c.get("valor")) and _n(c.get("operador")) in _OPS_FUERA
+                       for a in busq for c in a.get("condiciones") or [] if isinstance(c, dict))]
